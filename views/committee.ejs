<%- include('partials/header', { title: committee.name + ' | 委員会出席カウントシステム' }) %>

<p><a href="/">&laquo; 委員会一覧へ戻る</a></p>
<h1><%= committee.name %></h1>
<p>
  <a href="/committees/<%= committee.id %>/report">月別出席集計 &raquo;</a>
  &nbsp;|&nbsp;
  <a href="/committees/<%= committee.id %>/matrix">全体集計・出席グラフ &raquo;</a>
</p>

<% if (typeof importError !== 'undefined' && importError) { %>
  <div class="banner banner-error"><%= importError %></div>
<% } %>
<% if (typeof importSummary !== 'undefined' && importSummary && importSummary.length > 0) { %>
  <div class="banner <%= importSummary.some(r => r.error) ? 'banner-error' : 'banner-success' %>">
    <ul class="import-summary-list">
      <% importSummary.forEach(r => { %>
        <li>
          <strong><%= r.filename %></strong>:
          <% if (r.error) { %>
            <%= r.error %>
          <% } else { %>
            開催日 <%= r.meetingDate %><%= r.dateSource === 'filename' ? '（ファイル名から自動判定）' : '（入力欄の値を使用）' %> —
            全<%= r.total %>件（出席 <%= r.present %>名 / 新規委員登録 <%= r.created %>名）
          <% } %>
        </li>
      <% }) %>
    </ul>
  </div>
<% } %>

<section>
  <h2>委員</h2>
  <table class="list-table">
    <thead><tr><th>役職名</th><th>氏名</th><th>事業所名</th><th></th></tr></thead>
    <tbody>
      <% members.forEach(m => { %>
        <tr>
          <td><%= m.role || '' %></td>
          <td><%= m.name %></td>
          <td><%= m.company || '' %></td>
          <td>
            <a href="/committees/<%= committee.id %>/members/<%= m.id %>/edit">編集</a>
            <form method="post" action="/committees/<%= committee.id %>/members/<%= m.id %>/delete" class="inline-form"
                  onsubmit="return confirm('「<%= m.name %>」を削除します。よろしいですか？');">
              <button type="submit" class="danger">削除</button>
            </form>
          </td>
        </tr>
      <% }) %>
      <% if (members.length === 0) { %>
        <tr><td colspan="4" class="empty">委員が登録されていません</td></tr>
      <% } %>
    </tbody>
  </table>
  <form method="post" action="/committees/<%= committee.id %>/members" class="stack-form">
    <input type="text" name="role" placeholder="役職名（任意）" size="8">
    <input type="text" name="name" placeholder="氏名" required>
    <input type="text" name="company" placeholder="事業所名（任意）">
    <button type="submit">委員を追加</button>
  </form>
</section>

<section>
  <h2>開催日</h2>
  <table class="list-table">
    <thead><tr><th>開催日</th><th>議題・備考</th><th>出席数</th><th></th></tr></thead>
    <tbody>
      <% meetings.forEach(mt => { %>
        <tr>
          <td><a href="/committees/<%= committee.id %>/meetings/<%= mt.id %>"><%= mt.meeting_date %></a></td>
          <td><%= mt.title || '' %></td>
          <td><%= mt.present_count %> / <%= members.length %></td>
          <td>
            <form method="post" action="/committees/<%= committee.id %>/meetings/<%= mt.id %>/delete" class="inline-form"
                  onsubmit="return confirm('この開催日を削除します。よろしいですか？');">
              <button type="submit" class="danger">削除</button>
            </form>
          </td>
        </tr>
      <% }) %>
      <% if (meetings.length === 0) { %>
        <tr><td colspan="4" class="empty">開催日が登録されていません</td></tr>
      <% } %>
    </tbody>
  </table>
  <form method="post" action="/committees/<%= committee.id %>/meetings" class="stack-form">
    <input type="date" name="meeting_date" required>
    <input type="text" name="title" placeholder="議題・備考（任意）">
    <button type="submit">開催日を追加</button>
  </form>
</section>

<section>
  <h2>出欠CSVインポート</h2>
  <p class="hint">
    1行目に見出し（<code>氏名</code> と <code>出席</code> または <code>回答状況</code> の列）が必要です。
    出席は <code>○</code>・<code>参加</code>、欠席は空欄・<code>×</code>・<code>不参加</code> と判定します。
    <code>役職名</code>・<code>事業所名</code> 列があれば、CSVにしかいない新しい委員も自動で登録します。<br>
    開催日はファイル名から自動判定します（例: <code>0818.csv</code> → 8月18日、<code>20260818.csv</code> → 2026年8月18日、
    <code>4月.csv</code> → 4月1日として登録）。日までは分からず月だけ分かる場合は、ファイル名に「4月」のように
    入れておけば1日として自動登録されます。ファイル名から判定できない場合のみ、下の「開催日」欄の値を使用します。
    最大<%= 3 %>ファイルまで同時に選択できます。
  </p>
  <form method="post" action="/committees/<%= committee.id %>/import" enctype="multipart/form-data" class="stack-form">
    <input type="date" name="meeting_date" title="ファイル名から開催日を判定できなかった場合に使う開催日（任意）">
    <input type="text" name="title" placeholder="議題・備考（任意・新規作成時のみ使用）">
    <input type="file" name="csv" accept=".csv,text/csv" multiple required>
    <button type="submit">CSVをインポート</button>
  </form>
</section>

<%- include('partials/footer') %>
